# ==============================================================================
# OpenWrt Configuration: Linksys MX4300 (IPQ807x) - PPE-NSS Branch
# Fully Audited & Validated Production Build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TARGET PLATFORM & HARDWARE
# ------------------------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_linksys_mx4300=y
CONFIG_TARGET_INIT_PATH="/usr/sbin:/usr/bin:/sbin:/bin:/opt/usr/bin:/opt/bin:/opt/sbin:/opt/usr/sbin"
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ------------------------------------------------------------------------------
# 2. COMPILER & TOOLCHAIN OPTIMIZATION
# ------------------------------------------------------------------------------
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_DEVEL=y
CONFIG_EXPERIMENTAL=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

# ------------------------------------------------------------------------------
# 3. KERNEL & SECURITY HARDENING
# ------------------------------------------------------------------------------
CONFIG_BUILD_PATENTED=y
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHY (OpenSSL Enforced & DoQ/HTTP3 Support - mbedTLS Excluded)
# ------------------------------------------------------------------------------
# CONFIG_LUA_ECO_MBEDTLS is not set
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
# CONFIG_OPENSSL_WITH_CHACHA_POLY1305 is not set
CONFIG_OPENSSL_WITH_QUIC=y
# CONFIG_PACKAGE_apk-mbedtls is not set
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
# CONFIG_PACKAGE_libopenssl-oqsprovider is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_LIBCURL_MBEDTLS is not set
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_HTTP3=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y

# ------------------------------------------------------------------------------
# 5. HARDWARE ACCELERATION (PPE Flow-Offload & Native Shaper Stack)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_qca-ppe-qos=y
CONFIG_PACKAGE_luci-app-qca-ppe-qos=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-ppe=y
CONFIG_PACKAGE_luci-app-sqm=y

# TC Userspace and Scheduler Kmods for PPE Offload
CONFIG_PACKAGE_tc-tiny=y
# CONFIG_PACKAGE_tc is not set
# CONFIG_PACKAGE_tc-mod is not set
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-ets=y
CONFIG_PACKAGE_kmod-sched-red=y
CONFIG_PACKAGE_kmod-sched-gred=y
CONFIG_PACKAGE_dcb=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_devlink=y
CONFIG_KERNEL_DCB=y

# ------------------------------------------------------------------------------
# 6. WI-FI ACCELERATION & NSS FIRMWARE (qualcommax-nss-wifi.seed)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y

# NSS Driver Memory Profile (Enforces High for 2GB RAM)
CONFIG_NSS_MEM_PROFILE_HIGH=y
# CONFIG_NSS_MEM_PROFILE_MEDIUM is not set
# CONFIG_NSS_MEM_PROFILE_LOW is not set

# ------------------------------------------------------------------------------
# 7. NETWORK, VPN & CUSTOM PACKAGES
# ------------------------------------------------------------------------------
# Base Network Utilities
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
# CONFIG_HTOP_LMSENSORS is not set
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_rsync=y

# TCP BBR Congestion Control
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Custom DNS & Full IP Stack
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
# CONFIG_PACKAGE_odhcpd is not set
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Time Synchronization (Chrony with NTS & Disable BusyBox sysntpd)
# CONFIG_PACKAGE_chrony is not set
CONFIG_PACKAGE_chrony-nts=y
CONFIG_PACKAGE_ca-bundle=y
# CONFIG_BUSYBOX_DEFAULT_NTPD is not set
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_BUSYBOX_CONFIG_NTPD is not set

# AmneziaWG
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_luci-proto-amneziawg=y

# USB & Filesystems
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y

# ------------------------------------------------------------------------------
# 8. LUCI (WEB UI)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-bcp38=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ------------------------------------------------------------------------------
# 9. REPOSITORY & FEED PROTECTION (Prevent distfeeds 404 / wget Error 8)
# ------------------------------------------------------------------------------
# CONFIG_FEED_nss is not set
# CONFIG_FEED_sqm_scripts_nss is not set
